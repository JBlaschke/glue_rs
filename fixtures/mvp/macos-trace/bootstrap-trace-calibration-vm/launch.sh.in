#!/bin/sh
# Prototype run receipt. Constants alone cannot enable this renderer.
set -eu
umask 077
set -C
[ @@ENABLED@@ = 1 ] || { echo 'tracing execution is unconfigured' >&2; exit 2; }
[ "$#" -eq 0 ] || exit 2
@@READ_MATCH@@
PACKET=@@GUEST_PACKET@@
RECEIPT=@@GUEST_RUN_RECEIPT@@
EXPORT=@@GUEST_RECEIPT_EXPORT@@
read_match @@UID@@ /usr/bin/id -ru && read_match @@UID@@ /usr/bin/id -u || exit 2
read_match 0:41777 /usr/bin/stat -f %u:%p /System/Volumes/Data/private/tmp || exit 2
for ancestor in /Volumes '/Volumes/My Shared Files' '/Volumes/My Shared Files/glue-mvp-macos-vm-toolkit' "$PACKET"; do
    [ -d "$ancestor" ] && [ ! -L "$ancestor" ] || exit 2
done
[ -f "$PACKET/outer.sh" ] && [ ! -L "$PACKET/outer.sh" ] || exit 2
read_match @@OUTER_SIZE@@ /usr/bin/stat -f %z "$PACKET/outer.sh" || exit 2
read_match "@@OUTER_SHA_RAW@@  $PACKET/outer.sh" /usr/bin/shasum -a 256 "$PACKET/outer.sh" || exit 2
[ ! -e "$RECEIPT" ] && [ ! -L "$RECEIPT" ] || exit 2
/bin/mkdir -m 0700 "$RECEIPT"
/bin/chmod -N "$RECEIPT"
read_match @@UID@@:40700 /usr/bin/stat -f %u:%p "$RECEIPT" || exit 2
printf '%s\000' /usr/bin/env -i PATH=/usr/bin:/bin:/usr/sbin:/sbin LC_ALL=C TZ=UTC /bin/sh "$PACKET/outer.sh" > "$RECEIPT/outer.argv"
rc=0
/usr/bin/env -i PATH=/usr/bin:/bin:/usr/sbin:/sbin LC_ALL=C TZ=UTC /bin/sh "$PACKET/outer.sh" > "$RECEIPT/outer.stdout" 2> "$RECEIPT/outer.stderr" || rc=$?
printf '%s\n' "$rc" > "$RECEIPT/outer.status"
# No failed/uncertain outer inventory or export.
[ "$rc" = 0 ] || exit "$rc"
for ancestor in /Volumes '/Volumes/My Shared Files' '/Volumes/My Shared Files/glue-mvp-macos-vm-results'; do
    [ -d "$ancestor" ] && [ ! -L "$ancestor" ] || exit 1
done
[ ! -e "$EXPORT" ] && [ ! -L "$EXPORT" ] || exit 1
/bin/mkdir -m 0700 "$EXPORT"
for name in outer.argv outer.status outer.stdout outer.stderr; do
    [ -f "$RECEIPT/$name" ] && [ ! -L "$RECEIPT/$name" ] || exit 1
    read_match @@UID@@:100600:1 /usr/bin/stat -f %u:%p:%l "$RECEIPT/$name" || exit 1
    case "$name" in outer.argv) cap=8192 ;; outer.status) cap=4 ;; *) cap=65536 ;; esac
    size=$(/usr/bin/stat -f %z "$RECEIPT/$name") || exit 1
    [ "$size" -le "$cap" ] || exit 1
    /usr/bin/head -c "$cap" "$RECEIPT/$name" > "$EXPORT/$name" || exit 1
    read_match "$size" /usr/bin/stat -f %z "$EXPORT/$name" || exit 1
done
(
    cd "$EXPORT"
    for name in outer.argv outer.status outer.stdout outer.stderr; do /usr/bin/shasum -a 256 "$name" || exit 1; done
) > "$EXPORT/SHA256SUMS"
