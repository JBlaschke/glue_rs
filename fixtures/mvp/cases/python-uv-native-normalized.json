{
  "revision": 1,
  "case": "python-uv-native-normalized",
  "reference_kind": "stock",
  "inputs": [
    {
      "source": "${GLUE_MVP_PYTHON_ROOT}",
      "destination": "runtime"
    },
    {
      "source": "fixtures/mvp/python-native",
      "destination": "project"
    },
    {
      "source": "${GLUE_MVP_PYTHON_SITE}",
      "destination": "installed"
    },
    {
      "source": "${GLUE_MVP_PYTHON_SECONDARY}",
      "destination": "secondary"
    }
  ],
  "prepare": {
    "argv": [
      "${GLUE_MVP_PYTHON_TOOL}",
      "{repo}/fixtures/mvp/python-matrix/prepare.py",
